# ConjunctIQ Backend Environment Variables
# Copy this file to .env and fill in your values.

# ---------------------------------------------------------
# CORE BACKEND CONFIGURATION
# ---------------------------------------------------------
CONJUNCTIQ_DATABASE_URL=sqlite:///./conjunctiq.db

# ---------------------------------------------------------
# LLM / AI PROVIDER CONFIGURATION
# ---------------------------------------------------------
# Set this to "granite" to use real IBM Watsonx, or "mock" for local development without keys.
CONJUNCTIQ_LLM_PROVIDER=mock

# IBM Watsonx / Granite (Required if provider is "granite")
CONJUNCTIQ_LLM_API_KEY=your_ibm_cloud_api_key_here
CONJUNCTIQ_WATSONX_PROJECT_ID=your_watsonx_project_id_here
CONJUNCTIQ_WATSONX_URL=https://us-south.ml.cloud.ibm.com
CONJUNCTIQ_WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# OpenAI-Compatible Fallback (Optional)
# CONJUNCTIQ_LLM_PROVIDER=openai_compatible
# CONJUNCTIQ_OPENAI_BASE_URL=https://api.openai.com/v1
# CONJUNCTIQ_OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------
# EXTERNAL RESEARCH APIS
# ---------------------------------------------------------
# NASA/JPL CNEOS Close-Approach Data API
# Note: "DEMO_KEY" is a valid public key provided by NASA with strict rate limits.
CONJUNCTIQ_NASA_API_KEY=DEMO_KEY
CONJUNCTIQ_CNEOS_ENABLED=true
CONJUNCTIQ_CNEOS_CACHE_TTL_S=3600

# NASA Astrophysics Data System (ADS)
# Optional: Used for literature retrieval in the Research AI. Without it, the AI gracefully skips ADS searches.
ADS_API_KEY=

# JPL Horizons & SIMBAD
# These do not require API keys at the currently used endpoints.
